{
  "name": "reactiquiz-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm --prefix web run build",
    "start": "npm --prefix web start",
    "start:api": "node -e \"process.env.NODE_PATH='web/node_modules;node_modules'; process.env.PORT=3000; require('module').Module._initPaths(); require('./api/dev-server.js');\"",
    "test": "node -e \"process.env.NODE_PATH='web/node_modules;node_modules'; process.env.RUN_TESTS='1'; require('module').Module._initPaths(); require('./tests/run_all_tests.js');\"",
    "test:integration": "node -e \"process.env.NODE_PATH='web/node_modules;node_modules'; require('module').Module._initPaths(); require('./tests/backend_integration.test.js');\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.12.0",
    "@libsql/client": "^0.6.0",
    "@libsql/hrana-client": "^0.6.0",
    "@supabase/supabase-js": "^2.75.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "uuid": "^9.0.1"
  }
}
