{
  "version": 2,
  "buildCommand": "echo 'Backend deployment - skipping frontend build'",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_OPTIONS": "--max_old_space_size=4096"
  },
  "functions": {
    "api.js": {
      "maxDuration": 30
    }
  }
}