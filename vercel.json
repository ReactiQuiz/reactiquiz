{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_OPTIONS": "--max_old_space_size=4096"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}